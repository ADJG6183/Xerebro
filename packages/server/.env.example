# Copy to packages/server/.env (gitignored) and fill in.
# Enables AI explanations; without these the app uses template explanations.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=your-model-name

# Durable storage (npm run db:up -w @xerebro/server starts the container).
# Without this the server is in-memory and forgets everything on restart.
DATABASE_URL=postgres://xerebro:xerebro_dev@localhost:5433/xerebro
# PORT=3000
