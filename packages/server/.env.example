# Copy to packages/server/.env (gitignored) and fill in.
# Enables AI explanations; without these the app uses template explanations.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=your-model-name

# Durable storage (npm run db:up -w @xerebro/server starts the container).
# Without this the server is in-memory and forgets everything on restart.
DATABASE_URL=postgres://xerebro:xerebro_dev@localhost:5433/xerebro
# PORT=3000

# Bank linking (dashboard.plaid.com -> Team Settings -> Keys). Free sandbox
# keys connect to Plaid's fake banks with test credentials (user_good /
# pass_good). Without these, /plaid/* returns 503 and the app is manual-only.
# PLAID_CLIENT_ID=your-client-id
# PLAID_SECRET=your-sandbox-secret
# PLAID_ENV=sandbox
# Encrypts Plaid access tokens at rest. Generate: openssl rand -base64 32
# PLAID_TOKEN_KEY=your-base64-32-byte-key
# Public HTTPS URL Plaid should POST item updates to (needs a tunnel locally).
# PLAID_WEBHOOK_URL=https://your-tunnel.example.com/webhooks/plaid
